{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.modelcontextprotocol/server-filesystem",
  "title": "Filesystem",
  "description": "Read, write, and search local files within explicitly allowed directories.",
  "version": "2.2.0",
  "repository": {
    "url": "https://github.com/modelcontextprotocol/servers",
    "source": "github",
    "subfolder": "src/filesystem"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@modelcontextprotocol/server-filesystem",
      "version": "2.2.0",
      "runtimeHint": "npx",
      "transport": {"type": "stdio"},
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "allowed_directory",
          "description": "Directory the server may access; choose the narrowest necessary scope",
          "format": "filepath",
          "isRequired": true,
          "isRepeated": true
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "category": "Local Files",
      "tools": [
        {"name": "read_text_file", "description": "Read a text file in an allowed directory."},
        {"name": "list_directory", "description": "List files and directories."},
        {"name": "search_files", "description": "Search for files by pattern."}
      ],
      "tools_scope": "Selected discovery tools, not an exhaustive tool inventory.",
      "source": "https://github.com/modelcontextprotocol/servers/blob/main/src/filesystem/README.md"
    }
  }
}
