{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.awslabs/aws-documentation-mcp-server",
  "title": "AWS Documentation",
  "description": "Read and search AWS documentation and discover related reference material.",
  "version": "1.2.4",
  "repository": {
    "url": "https://github.com/awslabs/mcp",
    "source": "github",
    "subfolder": "src/aws-documentation-mcp-server"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "awslabs.aws-documentation-mcp-server",
      "version": "1.2.4",
      "runtimeHint": "uvx",
      "transport": {"type": "stdio"},
      "environmentVariables": [
        {"name": "AWS_DOCUMENTATION_PARTITION", "value": "aws"},
        {"name": "FASTMCP_LOG_LEVEL", "value": "ERROR"}
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "category": "Cloud Documentation",
      "tools": [
        {"name": "read_documentation", "description": "Read an AWS documentation page as Markdown."},
        {"name": "search_documentation", "description": "Search AWS documentation."},
        {"name": "recommend", "description": "Find related AWS documentation."}
      ],
      "tools_scope": "Selected discovery tools for the global AWS partition.",
      "source": "https://github.com/awslabs/mcp/blob/main/src/aws-documentation-mcp-server/README.md"
    }
  }
}
