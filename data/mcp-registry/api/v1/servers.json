{
  "schema": "mcp-registry-servers/1.0",
  "servers": [
    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "_meta": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "category": "Cloud Documentation",
          "source": "https://github.com/awslabs/mcp/blob/main/src/aws-documentation-mcp-server/README.md",
          "tools": [
            {
              "description": "Read an AWS documentation page as Markdown.",
              "name": "read_documentation"
            },
            {
              "description": "Search AWS documentation.",
              "name": "search_documentation"
            },
            {
              "description": "Find related AWS documentation.",
              "name": "recommend"
            }
          ],
          "tools_scope": "Selected discovery tools for the global AWS partition."
        }
      },
      "description": "Read and search AWS documentation and discover related reference material.",
      "name": "io.github.awslabs/aws-documentation-mcp-server",
      "packages": [
        {
          "environmentVariables": [
            {
              "name": "AWS_DOCUMENTATION_PARTITION",
              "value": "aws"
            },
            {
              "name": "FASTMCP_LOG_LEVEL",
              "value": "ERROR"
            }
          ],
          "identifier": "awslabs.aws-documentation-mcp-server",
          "registryBaseUrl": "https://pypi.org",
          "registryType": "pypi",
          "runtimeHint": "uvx",
          "transport": {
            "type": "stdio"
          },
          "version": "1.2.4"
        }
      ],
      "repository": {
        "source": "github",
        "subfolder": "src/aws-documentation-mcp-server",
        "url": "https://github.com/awslabs/mcp"
      },
      "title": "AWS Documentation",
      "version": "1.2.4"
    },
    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "_meta": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "authentication": "Requires a GitHub token; discovery does not contact the remote server.",
          "category": "Development",
          "source": "https://github.com/github/github-mcp-server",
          "tools": [
            {
              "description": "Search code across GitHub repositories.",
              "name": "search_code"
            },
            {
              "description": "List repository issues.",
              "name": "list_issues"
            },
            {
              "description": "Read repository files and directories.",
              "name": "get_file_contents"
            }
          ],
          "tools_scope": "Selected discovery tools, not an exhaustive tool inventory."
        }
      },
      "description": "Manage GitHub repositories, issues, pull requests, and workflows from AI assistants.",
      "name": "io.github.github/github-mcp-server",
      "remotes": [
        {
          "headers": [
            {
              "description": "GitHub authentication token (PAT or App token)",
              "isRequired": true,
              "isSecret": true,
              "name": "Authorization"
            }
          ],
          "type": "streamable-http",
          "url": "https://api.githubcopilot.com/mcp/"
        }
      ],
      "repository": {
        "source": "github",
        "url": "https://github.com/github/github-mcp-server"
      },
      "title": "GitHub",
      "version": "2.1.0"
    },
    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "_meta": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "category": "Browser Automation",
          "source": "https://github.com/microsoft/playwright-mcp/blob/main/README.md",
          "tools": [
            {
              "description": "Navigate to a URL.",
              "name": "browser_navigate"
            },
            {
              "description": "Capture the accessibility snapshot.",
              "name": "browser_snapshot"
            },
            {
              "description": "Click a page element.",
              "name": "browser_click"
            }
          ],
          "tools_scope": "Selected discovery tools, not an exhaustive tool inventory."
        }
      },
      "description": "Automate browsers using Playwright and structured accessibility snapshots.",
      "name": "io.github.microsoft/playwright-mcp",
      "packages": [
        {
          "identifier": "@playwright/mcp",
          "registryBaseUrl": "https://registry.npmjs.org",
          "registryType": "npm",
          "runtimeHint": "npx",
          "transport": {
            "type": "stdio"
          },
          "version": "0.0.84"
        }
      ],
      "repository": {
        "source": "github",
        "url": "https://github.com/microsoft/playwright-mcp"
      },
      "title": "Playwright",
      "version": "0.0.84"
    },
    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "_meta": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "category": "Local Files",
          "source": "https://github.com/modelcontextprotocol/servers/blob/main/src/filesystem/README.md",
          "tools": [
            {
              "description": "Read a text file in an allowed directory.",
              "name": "read_text_file"
            },
            {
              "description": "List files and directories.",
              "name": "list_directory"
            },
            {
              "description": "Search for files by pattern.",
              "name": "search_files"
            }
          ],
          "tools_scope": "Selected discovery tools, not an exhaustive tool inventory."
        }
      },
      "description": "Read, write, and search local files within explicitly allowed directories.",
      "name": "io.github.modelcontextprotocol/server-filesystem",
      "packages": [
        {
          "identifier": "@modelcontextprotocol/server-filesystem",
          "packageArguments": [
            {
              "description": "Directory the server may access; choose the narrowest necessary scope",
              "format": "filepath",
              "isRepeated": true,
              "isRequired": true,
              "type": "positional",
              "valueHint": "allowed_directory"
            }
          ],
          "registryBaseUrl": "https://registry.npmjs.org",
          "registryType": "npm",
          "runtimeHint": "npx",
          "transport": {
            "type": "stdio"
          },
          "version": "2.2.0"
        }
      ],
      "repository": {
        "source": "github",
        "subfolder": "src/filesystem",
        "url": "https://github.com/modelcontextprotocol/servers"
      },
      "title": "Filesystem",
      "version": "2.2.0"
    },
    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "_meta": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "category": "Documentation",
          "source": "https://github.com/upstash/context7/blob/master/README.md",
          "tools": [
            {
              "description": "Resolve a library name to its Context7 identifier.",
              "name": "resolve-library-id"
            },
            {
              "description": "Query documentation for a resolved library.",
              "name": "query-docs"
            }
          ]
        }
      },
      "description": "Retrieve up-to-date library documentation and code examples for AI assistants.",
      "name": "io.github.upstash/context7",
      "packages": [
        {
          "environmentVariables": [
            {
              "description": "Optional Context7 API key",
              "isRequired": false,
              "isSecret": true,
              "name": "CONTEXT7_API_KEY"
            }
          ],
          "identifier": "@upstash/context7-mcp",
          "registryBaseUrl": "https://registry.npmjs.org",
          "registryType": "npm",
          "runtimeHint": "npx",
          "transport": {
            "type": "stdio"
          },
          "version": "4.0.3"
        }
      ],
      "repository": {
        "source": "github",
        "url": "https://github.com/upstash/context7"
      },
      "title": "Context7",
      "version": "4.0.3"
    }
  ]
}
