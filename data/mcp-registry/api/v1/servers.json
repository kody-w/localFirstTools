{
  "schema": "mcp-registry-servers/1.0",
  "servers": [
    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "_meta": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "category": "Cloud documentation",
          "reviewed": "2026-11-09",
          "source": "https://github.com/awslabs/mcp/blob/main/src/aws-documentation-mcp-server/README.md",
          "tools": [
            {
              "name": "read_documentation"
            },
            {
              "name": "search_documentation"
            },
            {
              "name": "read_sections"
            },
            {
              "name": "search_table"
            },
            {
              "name": "recommend"
            }
          ],
          "toolsScope": "Global AWS documentation tools."
        }
      },
      "description": "Read and search AWS documentation, retrieve sections, and discover recommended guides.",
      "name": "io.github.awslabs/aws-documentation-mcp-server",
      "packages": [
        {
          "environmentVariables": [
            {
              "description": "Global AWS documentation partition.",
              "name": "AWS_DOCUMENTATION_PARTITION",
              "value": "aws"
            }
          ],
          "identifier": "awslabs.aws-documentation-mcp-server",
          "registryBaseUrl": "https://pypi.org",
          "registryType": "pypi",
          "runtimeHint": "uvx",
          "transport": {
            "type": "stdio"
          },
          "version": "1.2.4"
        }
      ],
      "repository": {
        "source": "github",
        "subfolder": "src/aws-documentation-mcp-server",
        "url": "https://github.com/awslabs/mcp"
      },
      "title": "AWS Documentation MCP Server",
      "version": "1.2.4"
    },
    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "_meta": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "category": "Developer tools",
          "reviewed": "2026-11-09",
          "source": "https://github.com/github/github-mcp-server/blob/main/README.md",
          "tools": [
            {
              "name": "get_file_contents"
            },
            {
              "name": "search_code"
            },
            {
              "name": "create_issue"
            },
            {
              "name": "list_commits"
            }
          ],
          "toolsScope": "Representative tools; availability depends on enabled toolsets and permissions."
        }
      },
      "description": "Manage GitHub repositories, code, issues, pull requests, and workflows.",
      "name": "io.github.github/github-mcp-server",
      "remotes": [
        {
          "headers": [
            {
              "description": "GitHub personal access token or app token.",
              "isRequired": true,
              "isSecret": true,
              "name": "Authorization"
            }
          ],
          "type": "streamable-http",
          "url": "https://api.githubcopilot.com/mcp/"
        }
      ],
      "repository": {
        "source": "github",
        "url": "https://github.com/github/github-mcp-server"
      },
      "title": "GitHub MCP Server",
      "version": "2.1.0"
    },
    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "_meta": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "category": "Browser automation",
          "reviewed": "2026-11-09",
          "source": "https://github.com/microsoft/playwright-mcp/blob/main/README.md",
          "tools": [
            {
              "name": "browser_navigate"
            },
            {
              "name": "browser_snapshot"
            },
            {
              "name": "browser_click"
            },
            {
              "name": "browser_take_screenshot"
            }
          ],
          "toolsScope": "Representative core automation tools."
        }
      },
      "description": "Automate browsers through Playwright accessibility snapshots, navigation, and interaction.",
      "name": "io.github.microsoft/playwright-mcp",
      "packages": [
        {
          "identifier": "@playwright/mcp",
          "registryBaseUrl": "https://registry.npmjs.org",
          "registryType": "npm",
          "runtimeHint": "npx",
          "transport": {
            "type": "stdio"
          },
          "version": "0.0.84"
        }
      ],
      "repository": {
        "source": "github",
        "url": "https://github.com/microsoft/playwright-mcp"
      },
      "title": "Playwright MCP",
      "version": "0.0.84"
    },
    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "_meta": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "category": "Local files",
          "reviewed": "2026-11-09",
          "source": "https://github.com/modelcontextprotocol/servers/blob/main/src/filesystem/README.md",
          "tools": [
            {
              "name": "read_file"
            },
            {
              "name": "write_file"
            },
            {
              "name": "list_directory"
            },
            {
              "name": "search_files"
            },
            {
              "name": "list_allowed_directories"
            }
          ],
          "toolsScope": "Representative filesystem tools; read-only mode omits write tools."
        }
      },
      "description": "Read, write, search, and manage files within explicitly allowed local directories.",
      "name": "io.github.modelcontextprotocol/server-filesystem",
      "packages": [
        {
          "identifier": "@modelcontextprotocol/server-filesystem",
          "packageArguments": [
            {
              "description": "Directory the server is allowed to access. Requires Node.js 24 or newer.",
              "format": "filepath",
              "isRepeated": true,
              "isRequired": true,
              "type": "positional",
              "valueHint": "allowed-directory"
            }
          ],
          "registryBaseUrl": "https://registry.npmjs.org",
          "registryType": "npm",
          "runtimeHint": "npx",
          "transport": {
            "type": "stdio"
          },
          "version": "2.2.0"
        }
      ],
      "repository": {
        "source": "github",
        "subfolder": "src/filesystem",
        "url": "https://github.com/modelcontextprotocol/servers"
      },
      "title": "Filesystem MCP Server",
      "version": "2.2.0"
    },
    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "_meta": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "category": "Documentation",
          "reviewed": "2026-11-09",
          "source": "https://github.com/upstash/context7/blob/master/README.md",
          "tools": [
            {
              "name": "resolve-library-id"
            },
            {
              "name": "query-docs"
            }
          ],
          "toolsScope": "Published MCP tools."
        }
      },
      "description": "Retrieve current library documentation and code examples for AI coding assistants.",
      "name": "io.github.upstash/context7",
      "packages": [
        {
          "environmentVariables": [
            {
              "description": "Optional API key for higher rate limits.",
              "isRequired": false,
              "isSecret": true,
              "name": "CONTEXT7_API_KEY"
            }
          ],
          "identifier": "@upstash/context7-mcp",
          "registryBaseUrl": "https://registry.npmjs.org",
          "registryType": "npm",
          "runtimeHint": "npx",
          "transport": {
            "type": "stdio"
          },
          "version": "4.0.3"
        }
      ],
      "remotes": [
        {
          "type": "streamable-http",
          "url": "https://mcp.context7.com/mcp"
        }
      ],
      "repository": {
        "source": "github",
        "url": "https://github.com/upstash/context7"
      },
      "title": "Context7",
      "version": "4.0.3"
    }
  ]
}
