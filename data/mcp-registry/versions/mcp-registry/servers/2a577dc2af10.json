{
  "schema": "mcp-registry-servers/1.0",
  "servers": [
    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "_meta": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "category": "Documentation",
          "documentation": "https://github.com/awslabs/mcp/tree/main/src/aws-documentation-mcp-server",
          "tools": [
            {
              "name": "search_documentation"
            },
            {
              "name": "read_documentation"
            },
            {
              "name": "recommend"
            }
          ]
        }
      },
      "description": "Search, read, and discover related official AWS documentation.",
      "name": "io.github.awslabs/aws-documentation-mcp-server",
      "packages": [
        {
          "identifier": "awslabs.aws-documentation-mcp-server",
          "registryBaseUrl": "https://pypi.org",
          "registryType": "pypi",
          "runtimeHint": "uvx",
          "transport": {
            "type": "stdio"
          },
          "version": "1.2.4"
        }
      ],
      "repository": {
        "source": "github",
        "subfolder": "src/aws-documentation-mcp-server",
        "url": "https://github.com/awslabs/mcp"
      },
      "title": "AWS Documentation",
      "version": "1.2.4"
    },
    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "_meta": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "catalog_note": "Curated capabilities, not an exhaustive tool list. Authentication is required.",
          "category": "Development",
          "documentation": "https://github.com/github/github-mcp-server#readme",
          "tools": [
            {
              "name": "search_code"
            },
            {
              "name": "list_issues"
            },
            {
              "name": "get_file_contents"
            }
          ]
        }
      },
      "description": "Search code and manage GitHub repositories, issues, and pull requests.",
      "name": "io.github.github/github-mcp-server",
      "remotes": [
        {
          "headers": [
            {
              "description": "GitHub personal access token with permissions for the resources you use.",
              "name": "Authorization",
              "value": "Bearer {token}",
              "variables": {
                "token": {
                  "isRequired": true,
                  "isSecret": true
                }
              }
            }
          ],
          "type": "streamable-http",
          "url": "https://api.githubcopilot.com/mcp/"
        }
      ],
      "repository": {
        "source": "github",
        "url": "https://github.com/github/github-mcp-server"
      },
      "title": "GitHub",
      "version": "1.0.0"
    },
    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "_meta": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "catalog_note": "Curated capabilities, not an exhaustive tool list.",
          "category": "Browser automation",
          "documentation": "https://github.com/microsoft/playwright-mcp#readme",
          "tools": [
            {
              "name": "browser_navigate"
            },
            {
              "name": "browser_snapshot"
            },
            {
              "name": "browser_click"
            }
          ]
        }
      },
      "description": "Automate browser navigation and interaction using structured accessibility snapshots.",
      "name": "io.github.microsoft/playwright-mcp",
      "packages": [
        {
          "identifier": "@playwright/mcp",
          "registryBaseUrl": "https://registry.npmjs.org",
          "registryType": "npm",
          "runtimeHint": "npx",
          "transport": {
            "type": "stdio"
          },
          "version": "0.0.84"
        }
      ],
      "repository": {
        "source": "github",
        "url": "https://github.com/microsoft/playwright-mcp"
      },
      "title": "Playwright",
      "version": "0.0.84"
    },
    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "_meta": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "catalog_note": "Curated capabilities, not an exhaustive tool list. Only allow trusted directories.",
          "category": "Local files",
          "documentation": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem",
          "tools": [
            {
              "name": "read_file"
            },
            {
              "name": "list_directory"
            },
            {
              "name": "search_files"
            }
          ]
        }
      },
      "description": "Read and search local files within explicitly allowed directories.",
      "name": "io.github.modelcontextprotocol/server-filesystem",
      "packages": [
        {
          "identifier": "@modelcontextprotocol/server-filesystem",
          "packageArguments": [
            {
              "description": "Directory that this server is permitted to access.",
              "format": "filepath",
              "isRepeated": true,
              "isRequired": true,
              "type": "positional",
              "valueHint": "allowed-directory"
            }
          ],
          "registryBaseUrl": "https://registry.npmjs.org",
          "registryType": "npm",
          "runtimeHint": "npx",
          "transport": {
            "type": "stdio"
          },
          "version": "2.2.0"
        }
      ],
      "repository": {
        "source": "github",
        "subfolder": "src/filesystem",
        "url": "https://github.com/modelcontextprotocol/servers"
      },
      "title": "Filesystem",
      "version": "2.2.0"
    },
    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "_meta": {
        "io.modelcontextprotocol.registry/publisher-provided": {
          "category": "Documentation",
          "documentation": "https://github.com/upstash/context7#readme",
          "tools": [
            {
              "name": "resolve-library-id"
            },
            {
              "name": "query-docs"
            }
          ]
        }
      },
      "description": "Retrieve current library documentation and code examples for development tasks.",
      "name": "io.github.upstash/context7",
      "packages": [
        {
          "identifier": "@upstash/context7-mcp",
          "registryBaseUrl": "https://registry.npmjs.org",
          "registryType": "npm",
          "runtimeHint": "npx",
          "transport": {
            "type": "stdio"
          },
          "version": "4.5.1"
        }
      ],
      "repository": {
        "source": "github",
        "url": "https://github.com/upstash/context7"
      },
      "title": "Context7",
      "version": "4.5.1"
    }
  ]
}
