name: Evergreen capability loop

on:
  pull_request:
    paths:
      - ".github/workflows/capability-loop.yml"
      - "scripts/capability_*.py"
      - "scripts/check_capability_loop.py"
      - "tests/test_capability_*.py"
      - "landgrab/autocomplete/capabilities/**"
      - "CAPABILITIES.md"
      - "AGENTS.md"
  push:
    branches: [main]
    paths:
      - "scripts/capability_*.py"
      - "scripts/check_capability_loop.py"
      - "tests/test_capability_*.py"
      - "landgrab/autocomplete/capabilities/**"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: capability-loop-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  qualify-and-reuse:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Obtain the pinned reference and independent public source
        shell: bash
        run: |
          set -euo pipefail
          reference="$RUNNER_TEMP/capability-rapp-reference"
          git init --quiet "$reference"
          git -C "$reference" remote add origin https://github.com/kody-w/rapp-1.git
          git -C "$reference" fetch --quiet --depth=1 origin eb50008011447f5e69372ac22a1755f0978d15ed
          git -C "$reference" checkout --quiet --detach FETCH_HEAD
          source="../openrappter-reuse-snapshot"
          git init --quiet "$source"
          git -C "$source" remote add origin https://github.com/kody-w/openrappter.git
          git -C "$source" fetch --quiet --depth=1 origin f3c64386d69a6c54689e774ef777afbd38961b19
          git -C "$source" checkout --quiet --detach FETCH_HEAD
          git fetch --quiet --no-tags origin b60ba4eefb5ab99dccb5b44dc9080f35dc33ce33
          echo "RAPP_REFERENCE_DIR=$reference" >> "$GITHUB_ENV"
      - name: Qualify the registry, packages, and bounded reuse loop
        run: python3 scripts/check_capability_loop.py --root . --rapp-dir "$RAPP_REFERENCE_DIR" --exercise
