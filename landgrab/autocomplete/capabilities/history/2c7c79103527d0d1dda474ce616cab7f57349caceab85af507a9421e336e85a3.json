{
  "schema": "localfirst-capability/v1",
  "id": "source-capsule",
  "version": "1.0.0",
  "title": "Committed source capsule",
  "job": "Transfer and safely restore an explicitly selected public UTF-8 source artifact from an exact Git commit, retaining fingerprints, modes and qualification evidence.",
  "entrypoint": "scripts/capability_package.py",
  "artifacts": [
    {
      "path": "scripts/capability_package.py",
      "sha256": "813bfe388e72a7b7019d609da4ee99a73719e3f74298420e0e391d64c6f75e42",
      "bytes": 21771
    },
    {
      "path": "scripts/capability_contracts.py",
      "sha256": "06dac1f0e3d9e65ab801d76e42725e3877232f5a0c88a6f738fb1f76b7304d44",
      "bytes": 7540
    },
    {
      "path": "scripts/autocomplete_catalog.py",
      "sha256": "e85d6b128a06536b9b42a532fee37a44d1eaf0184f59a9ad96bd1b6768ee8c6d",
      "bytes": 37611
    },
    {
      "path": "scripts/autocomplete_frames.py",
      "sha256": "c2b0dec0f5e0801f2258a998c0b457e6ba10355491a2aae53316da41cd0c794c",
      "bytes": 42846
    },
    {
      "path": "tests/test_capability_package.py",
      "sha256": "d630e87ef6d4d6420390b79cab6c48e3af981f1dd37da39c4b4c9e00e2cdba18",
      "bytes": 22209
    },
    {
      "path": "tests/test_capability_contracts.py",
      "sha256": "629179245081a01520633636ca0211f8dab349cb56f3e89eb9a2b2cd03c82070",
      "bytes": 5020
    }
  ],
  "contract": {
    "inputs": {
      "type": "object",
      "required": ["repository", "commit", "paths"],
      "properties": {
        "repository": {"type": "string", "description": "Public GitHub owner/name."},
        "commit": {"type": "string", "description": "Exact available Git commit, not a mutable branch label."},
        "paths": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 32}
      }
    },
    "outputs": {
      "type": "object",
      "required": ["capsule", "qualification"],
      "properties": {
        "capsule": {"type": "object", "description": "Deterministic localfirst-source-capsule/v1 document with exact UTF-8 file bytes and modes."},
        "qualification": {"type": "object", "description": "Source comparison, fresh restore and actual declared-check results, bound to a replay command."}
      }
    },
    "permissions": ["repository.read", "artifact.write", "process.execute"],
    "network": "none"
  },
  "checks": [
    {
      "id": "capsule-behavior",
      "argv": ["python3", "-B", "-m", "unittest", "discover", "-s", "tests", "-p", "test_capability_package.py", "-q"],
      "timeout_seconds": 90
    },
    {
      "id": "capability-contract",
      "argv": ["python3", "-B", "-m", "unittest", "discover", "-s", "tests", "-p", "test_capability_contracts.py", "-q"],
      "timeout_seconds": 30
    }
  ],
  "failure_cases": [
    "Tampered capsule bytes, sizes or hashes are refused.",
    "Traversal, symlink, private-path and non-UTF-8 source inputs are refused.",
    "An occupied restoration destination is not overlaid.",
    "Changed implementation bytes invalidate the manifest revision.",
    "Altered qualification gates or replay-command bindings are refused.",
    "Failed real commands cannot produce a passing qualification."
  ],
  "reuses": [],
  "visibility": "public"
}
